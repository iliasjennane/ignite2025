@inherits LayoutComponentBase
@using MudBlazor

<div class="app-layout">
    <div class="nav-drawer @(drawerOpen ? "drawer-open" : "drawer-collapsed")">
        <div class="drawer-header">
            @if (drawerOpen)
            {
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Medium" Class="brand-icon" />
                <MudText Typo="Typo.h6" Class="drawer-title">Agent Council</MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Medium" Class="brand-icon" />
            }
            <MudIconButton Icon="@(drawerOpen ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)" 
                          Size="Size.Small" 
                          OnClick="@(() => drawerOpen = !drawerOpen)"
                          Class="drawer-toggle"
                          Style="color: #667eea;" />
        </div>
        
        <MudNavMenu Class="nav-menu">
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
                @if (drawerOpen) { <text>Dashboard</text> }
            </MudNavLink>
            
            @if (drawerOpen)
            {
                <MudDivider Class="nav-divider" />
                <MudText Typo="Typo.caption" Class="nav-section-header">ORCHESTRATOR</MudText>
            }
            
            <MudNavLink Href="/agents/chief-analyst" Icon="@Icons.Material.Filled.Psychology">
                @if (drawerOpen) { <text>Chief Analyst</text> }
            </MudNavLink>
            
            @if (drawerOpen)
            {
                <MudDivider Class="nav-divider" />
                <MudText Typo="Typo.caption" Class="nav-section-header">DOMAIN EXPERTS</MudText>
            }
            
            <MudNavLink Href="/agents/sales-domain-expert" Icon="@Icons.Material.Filled.TrendingUp">
                @if (drawerOpen) { <text>Sales</text> }
            </MudNavLink>
            <MudNavLink Href="/agents/incentives-domain-expert" Icon="@Icons.Material.Filled.Redeem">
                @if (drawerOpen) { <text>Incentives</text> }
            </MudNavLink>
            <MudNavLink Href="/agents/inventory-domain-expert" Icon="@Icons.Material.Filled.Inventory">
                @if (drawerOpen) { <text>Inventory</text> }
            </MudNavLink>
            <MudNavLink Href="/agents/car-models-domain-expert" Icon="@Icons.Material.Filled.DirectionsCar">
                @if (drawerOpen) { <text>Car Models</text> }
            </MudNavLink>
            <MudNavLink Href="/agents/customers-domain-expert" Icon="@Icons.Material.Filled.People">
                @if (drawerOpen) { <text>Customers</text> }
            </MudNavLink>
            <MudNavLink Href="/agents/dealers-domain-expert" Icon="@Icons.Material.Filled.Store">
                @if (drawerOpen) { <text>Dealers</text> }
            </MudNavLink>
            
            @if (drawerOpen)
            {
                <MudDivider Class="nav-divider" />
                <MudText Typo="Typo.caption" Class="nav-section-header">MONITORING</MudText>
            }
            
            <MudNavLink Href="/monitoring" Icon="@Icons.Material.Filled.Analytics">
                @if (drawerOpen) { <text>Monitoring</text> }
            </MudNavLink>
            <MudNavLink Href="/charttest" Icon="@Icons.Material.Filled.BarChart">
                @if (drawerOpen) { <text>Chart Test</text> }
            </MudNavLink>
        </MudNavMenu>
    </div>

    <div class="main-content">
        @Body
    </div>
</div>

@code {
    private bool drawerOpen = true;
}