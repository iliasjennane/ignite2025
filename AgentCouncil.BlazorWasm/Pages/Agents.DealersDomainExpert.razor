@page "/agents/dealers-domain-expert"
@using AgentCouncil.BlazorWasm.Services
@using AgentCouncil.BlazorWasm.Models
@inject IAgentsClient AgentsClient
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.False" Style="padding: 0; height: 100vh; display: flex; flex-direction: column;">
    <div class="agent-header">
        <div class="agent-title-group">
            <div class="agent-icon" style="background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);">
                <MudIcon Icon="@Icons.Material.Filled.Store" Style="color: white; font-size: 16px;" />
            </div>
            <div>
                <MudText Typo="Typo.h6" Style="color: #2c3e50; font-weight: 700; margin: 0; line-height: 1.2; font-size: 1rem;">Dealers Domain Expert</MudText>
                <MudText Typo="Typo.caption" Style="color: #666; margin: 0; font-size: 0.7rem;">Dealer network and performance analysis</MudText>
            </div>
        </div>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => showPrompts = !showPrompts)" Style="color: #34495e; min-width: auto; padding: 4px 8px;">
            <MudIcon Icon="@(showPrompts ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Style="font-size: 18px;" />
        </MudButton>
    </div>
    
    @if (showPrompts)
    {
        <div class="prompts-container">
            <MudChip T="string" Text="1. Recall" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("List all dealers with their corresponding regions."); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
            <MudChip T="string" Text="2. Aggregation" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("How many dealers operate in each region?"); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
            <MudChip T="string" Text="3. Pattern" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("Which dealers appear in more than one region?"); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
            <MudChip T="string" Text="4. Performance" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("Identify dealers in low-performing regions."); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
            <MudChip T="string" Text="5. Synthesis" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("Provide a short summary of how dealer distribution supports national coverage."); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
        </div>
    }

    <div class="chat-wrapper">
        <div class="chat-container" style="scrollbar-color: #34495e #f1f1f1;">
            <div class="chat-messages">
                @if (messages.Count == 0)
                {
                    <div class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Large" Style="color: #34495e; opacity: 0.6;" />
                        <MudText Typo="Typo.h6" Align="MudBlazor.Align.Center" Style="color: #666;">
                            Start a conversation with the Dealers Domain Expert
                        </MudText>
                        <MudText Typo="Typo.body2" Align="MudBlazor.Align.Center" Style="color: #999;">
                            Click the prompt suggestions above or ask your own question
                        </MudText>
                    </div>
                }
                else
                {
                    @foreach (var message in messages)
                    {
                        <div class="message-row @(message.IsUser ? "user-message" : "assistant-message")">
                            @if (!message.IsUser)
                            {
                                <div class="avatar assistant-avatar" style="background-color: #34495e;">
                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Style="font-size: 14px;" />
                                </div>
                            }
                            <div class="message-content">
                                <div class="message-bubble @(message.IsUser ? "user-bubble" : "assistant-bubble")">
                                    <MudText Typo="Typo.body1" Style="white-space: pre-wrap; margin: 0; font-size: 0.9rem; line-height: 1.5;">@message.Content</MudText>
                                    <MudText Typo="Typo.caption" Style="@GetTimestampStyle(message)">@message.Timestamp.ToString("HH:mm")</MudText>
                                </div>
                            </div>
                            @if (message.IsUser)
                            {
                                <div class="avatar user-avatar">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 14px;" />
                                </div>
                            }
                        </div>
                    }
                }
                @if (isLoading)
                {
                    <div class="message-row assistant-message">
                        <div class="avatar assistant-avatar" style="background-color: #34495e;">
                            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Style="font-size: 14px;" />
                        </div>
                        <div class="message-content">
                            <div class="message-bubble assistant-bubble loading-bubble">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width: 16px; height: 16px;" />
                                <MudText Typo="Typo.body2" Style="color: #666; margin-left: 8px;">Analyzing...</MudText>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="input-container">
            <form @onsubmit="SendMessage" @onsubmit:preventDefault>
                <div class="input-row">
                    <MudIconButton Icon="@Icons.Material.Filled.Mic"
                                   Color="Color.Secondary"
                                   OnClick="StartVoiceInput"
                                   Disabled="@isLoading"
                                   ButtonType="ButtonType.Button"
                                   Size="Size.Small"
                                   Style="color: #34495e; flex-shrink: 0;" />
                    <MudTextField @bind-Value="currentMessage" 
                                 Placeholder="Type your message... (Enter to send)" 
                                 Variant="Variant.Outlined" 
                                 Lines="1"
                                 Disabled="@isLoading"
                                 FullWidth="true"
                                 Margin="Margin.None"
                                 Style="flex: 1; background: white; min-width: 0;" />
                    <MudIconButton Icon="@Icons.Material.Filled.Send"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="@(isLoading || string.IsNullOrWhiteSpace(currentMessage))"
                                   Size="Size.Small"
                                   Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; flex-shrink: 0;" />
                </div>
            </form>
        </div>
    </div>
</MudContainer>

<style>
.agent-header { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 1rem; border-bottom: 1px solid rgba(0,0,0,0.08); background: white; flex-shrink: 0; }
.agent-title-group { display: flex; align-items: center; gap: 0.5rem; }
.agent-icon { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.prompts-container { display: flex; gap: 0.5rem; padding: 0.5rem 1rem; background: #f8f9fa; border-bottom: 1px solid rgba(0,0,0,0.08); flex-wrap: wrap; flex-shrink: 0; }
.chat-wrapper { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: white; }
.chat-container { flex: 1; overflow-y: auto; background: #fafafa; scrollbar-width: thin; }
.chat-container::-webkit-scrollbar { width: 6px; }
.chat-container::-webkit-scrollbar-track { background: #f1f1f1; }
.chat-container::-webkit-scrollbar-thumb { background: #34495e; border-radius: 3px; }
.chat-container::-webkit-scrollbar-thumb:hover { background: #2c3e50; }
.chat-messages { padding: 1rem; min-height: 100%; display: flex; flex-direction: column; }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 3rem 1rem; text-align: center; }
.message-row { display: flex; align-items: flex-start; gap: 6px; margin-bottom: 10px; }
.user-message { justify-content: flex-end; gap: 4px; }
.assistant-message { justify-content: flex-start; }
.avatar { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; color: white; }
.user-avatar { background-color: #667eea; }
.message-content { max-width: min(90%, 900px); display: flex; flex-direction: column; }
.message-bubble { padding: 8px 12px; border-radius: 10px; word-wrap: break-word; }
.user-bubble { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
.assistant-bubble { background: white; color: #333; border: 1px solid #e0e0e0; }
.loading-bubble { display: flex; align-items: center; background: #f8f9fa; }
.input-container { padding: 0.75rem 1rem; background: white; border-top: 1px solid rgba(0,0,0,0.08); flex-shrink: 0; }
.input-row { display: flex; align-items: center; gap: 8px; }
</style>

@code {
    private string currentMessage = "";
    private bool isLoading = false;
    private bool showPrompts = false;
    private List<ChatMessage> messages = new();

    protected override void OnInitialized()
    {
        messages.Add(new ChatMessage 
        { 
            Content = "Hello! I'm the Dealers Domain Expert. I specialize in analyzing dealer network performance, sales effectiveness, and identifying opportunities for improvement. How can I help you today?", 
            IsUser = false, 
            Timestamp = DateTime.Now 
        });
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage)) return;
        var userMessage = new ChatMessage { Content = currentMessage, IsUser = true, Timestamp = DateTime.Now };
        messages.Add(userMessage);
        var messageToSend = currentMessage;
        currentMessage = "";
        isLoading = true;

        try
        {
            var request = new AgentRequest(AgentName: "dealers_domain_expert", Query: messageToSend);
            var response = await AgentsClient.ExecuteAsync(request);
            var agentMessage = new ChatMessage
            {
                Content = response?.Summary ?? "I'm sorry, I couldn't process your request at the moment. Please try again.",
                IsUser = false,
                Timestamp = DateTime.Now
            };
            messages.Add(agentMessage);
        }
        catch (Exception ex)
        {
            var errorMessage = new ChatMessage
            {
                Content = $"I encountered an error: {ex.Message}. Please check your connection and try again.",
                IsUser = false,
                Timestamp = DateTime.Now
            };
            messages.Add(errorMessage);
        }
        finally { isLoading = false; }
    }

    private void SetQuery(string query) => currentMessage = query;
    private async Task StartVoiceInput() => await JSRuntime.InvokeVoidAsync("alert", "Voice input feature coming soon! 🎤");
    private string GetTimestampStyle(ChatMessage message) => message.IsUser 
        ? "color: rgba(255,255,255,0.7); margin-top: 4px; font-size: 0.75rem;"
        : "color: #999; margin-top: 4px; font-size: 0.75rem;";

    public class ChatMessage
    {
        public string Content { get; set; } = "";
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; }
    }
}
