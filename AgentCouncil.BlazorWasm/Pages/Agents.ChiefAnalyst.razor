@page "/agents/chief-analyst"
@using AgentCouncil.BlazorWasm.Services
@using AgentCouncil.BlazorWasm.Models
@inject IAgentsClient AgentsClient
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.False" Style="padding: 0; height: 100vh; display: flex; flex-direction: column;">
    <!-- Compact Header -->
    <div class="agent-header">
        <div class="agent-title-group">
            <div class="agent-icon" style="background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);">
                <MudIcon Icon="@Icons.Material.Filled.Psychology" Style="color: white; font-size: 16px;" />
            </div>
            <div>
                <MudText Typo="Typo.h6" Style="color: #2c3e50; font-weight: 700; margin: 0; line-height: 1.2; font-size: 1rem;">Chief Analyst Agent</MudText>
                <MudText Typo="Typo.caption" Style="color: #666; margin: 0; font-size: 0.7rem;">Orchestrate all analysts</MudText>
            </div>
        </div>
        
        <!-- Collapsible Quick Query Chips -->
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => showPrompts = !showPrompts)" Style="color: #f39c12; min-width: auto; padding: 4px 8px;">
            <MudIcon Icon="@(showPrompts ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Style="font-size: 18px;" />
        </MudButton>
    </div>
    
    @if (showPrompts)
    {
        <div class="prompts-container">
            <MudChip T="string" Text="1. Compare Trends" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("Compare internal sales trends with national market performance."); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
            <MudChip T="string" Text="2. Cross-Analysis" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("Which dealers underperformed despite high incentive activity?"); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
            <MudChip T="string" Text="3. Alignment" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("How does inventory align with customer demand and sales data?"); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
            <MudChip T="string" Text="4. Performance" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("Identify top-performing regions and summarize external factors that explain their success."); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
            <MudChip T="string" Text="5. Executive Summary" Size="Size.Small" Color="Color.Default" OnClick="@(() => { SetQuery("Provide a unified executive summary combining internal and external insights for Q2 2025."); showPrompts = false; })" Style="cursor: pointer; height: 22px; font-size: 0.7rem;" />
        </div>
    }

    <!-- Chat Interface - Full Height -->
    <div class="chat-wrapper">
        <!-- Chat Messages -->
        <div class="chat-container" style="scrollbar-color: #f39c12 #f1f1f1;">
            <div class="chat-messages">
                @if (messages.Count == 0)
                {
                    <div class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Large" Style="color: #f39c12; opacity: 0.6;" />
                        <MudText Typo="Typo.h6" Align="MudBlazor.Align.Center" Style="color: #666;">
                            Start a conversation with the Chief Analyst agent
                        </MudText>
                        <MudText Typo="Typo.body2" Align="MudBlazor.Align.Center" Style="color: #999;">
                            Click the prompt suggestions above or ask your own question
                        </MudText>
                    </div>
                }
                else
                {
                    @foreach (var message in messages)
                    {
                        <div class="message-row @(message.IsUser ? "user-message" : "assistant-message")">
                            @if (!message.IsUser)
                            {
                                <div class="avatar assistant-avatar" style="background-color: #f39c12;">
                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Style="font-size: 14px;" />
                                </div>
                            }
                            <div class="message-content">
                                <div class="message-bubble @(message.IsUser ? "user-bubble" : "assistant-bubble")">
                                    <MudText Typo="Typo.body1" Style="white-space: pre-wrap; margin: 0; font-size: 0.9rem; line-height: 1.5;">@message.Content</MudText>
                                    <MudText Typo="Typo.caption" Style="@GetTimestampStyle(message)">@message.Timestamp.ToString("HH:mm")</MudText>
                                </div>
                                @if (!message.IsUser && message.UsedTools?.Any() == true)
                                {
                                    <div class="tool-indicators-row">
                                        @foreach (var tool in availableTools.Where(t => message.UsedTools.Contains(t.Name)))
                                        {
                                            <div class="tool-indicator-small active" data-tip="@tool.DisplayName">
                                                <MudIcon Icon="@tool.Icon" Style="font-size: 12px;" />
                                                <span class="tool-tip">@tool.DisplayName</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            @if (message.IsUser)
                            {
                                <div class="avatar user-avatar">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 14px;" />
                                </div>
                            }
                        </div>
                    }
                }
                @if (isLoading)
                {
                    <div class="message-row assistant-message">
                        <div class="avatar assistant-avatar" style="background-color: #f39c12;">
                            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Style="font-size: 14px;" />
                        </div>
                        <div class="message-content">
                            <div class="message-bubble assistant-bubble loading-bubble">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width: 16px; height: 16px;" />
                                <MudText Typo="Typo.body2" Style="color: #666; margin-left: 8px;">Analyzing...</MudText>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Input Area -->
        <div class="input-container">
            <form @onsubmit="SendMessage" @onsubmit:preventDefault>
                <div class="input-row">
                    <MudIconButton Icon="@Icons.Material.Filled.Mic"
                                   Color="Color.Secondary"
                                   OnClick="StartVoiceInput"
                                   Disabled="@isLoading"
                                   ButtonType="ButtonType.Button"
                                   Size="Size.Small"
                                   Style="color: #f39c12; flex-shrink: 0;" />
                    <MudTextField @bind-Value="currentMessage" 
                                 Placeholder="Type your message... (Enter to send)" 
                                 Variant="Variant.Outlined" 
                                 Lines="1"
                                 Disabled="@isLoading"
                                 FullWidth="true"
                                 Margin="Margin.None"
                                 Style="flex: 1; background: white; min-width: 0;" />
                    <MudIconButton Icon="@Icons.Material.Filled.Send"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="@(isLoading || string.IsNullOrWhiteSpace(currentMessage))"
                                   Size="Size.Small"
                                   Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; flex-shrink: 0;" />
                </div>
            </form>
        </div>
    </div>
</MudContainer>

<style>
/* Compact Header */
.agent-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    background: white;
    flex-shrink: 0;
}

.agent-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.agent-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.prompts-container {
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: #f8f9fa;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    flex-wrap: wrap;
    flex-shrink: 0;
}

/* Full Height Chat Wrapper */
.chat-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: white;
}

.chat-container {
    flex: 1;
    overflow-y: auto;
    background: #fafafa;
    scrollbar-width: thin;
}

.chat-container::-webkit-scrollbar { width: 6px; }
.chat-container::-webkit-scrollbar-track { background: #f1f1f1; }
.chat-container::-webkit-scrollbar-thumb { background: #f39c12; border-radius: 3px; }
.chat-container::-webkit-scrollbar-thumb:hover { background: #e67e22; }

.chat-messages {
    padding: 1rem;
    min-height: 100%;
    display: flex;
    flex-direction: column;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 3rem 1rem;
    text-align: center;
}

/* Optimized Message Layout */
.message-row {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: 10px;
}

.user-message {
    justify-content: flex-end;
    gap: 4px;
}

.assistant-message {
    justify-content: flex-start;
}

.avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
    color: white;
}

.user-avatar {
    background-color: #667eea;
}

.message-content {
    max-width: min(90%, 900px);
    display: flex;
    flex-direction: column;
}

.message-bubble {
    padding: 8px 12px;
    border-radius: 10px;
    word-wrap: break-word;
}

.user-bubble {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.assistant-bubble {
    background: white;
    color: #333;
    border: 1px solid #e0e0e0;
}

.loading-bubble {
    display: flex;
    align-items: center;
    background: #f8f9fa;
}

/* Tool Indicators Row */
.tool-indicators-row {
    display: flex;
    gap: 6px;
    margin-top: 4px;
    padding-left: 4px;
}

.tool-indicator-small {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    transition: all 0.3s ease;
    cursor: pointer;
    position: relative;
}

.tool-indicator-small.active {
    background-color: rgba(40, 167, 69, 0.15);
    color: #28a745;
    box-shadow: 0 0 0 1px rgba(40, 167, 69, 0.3);
}

.tool-indicator-small .tool-tip {
    position: absolute;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.8);
    color: #fff;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 10px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s ease;
}

.tool-indicator-small:hover .tool-tip {
    opacity: 1;
}

/* Input Container */
.input-container {
    padding: 0.75rem 1rem;
    background: white;
    border-top: 1px solid rgba(0,0,0,0.08);
    flex-shrink: 0;
}

.input-row {
    display: flex;
    align-items: center;
    gap: 8px;
}
</style>

@code {
    private string currentMessage = "";
    private bool isLoading = false;
    private bool showPrompts = false;
    private List<ChatMessage> messages = new();
    private List<ToolInfo> availableTools = new();

    protected override void OnInitialized()
    {
        messages.Add(new ChatMessage 
        { 
            Content = "Hello! I'm the Chief Analyst Agent. I orchestrate all other agents to provide you with comprehensive, unified insights and strategic recommendations. How can I help you today?", 
            IsUser = false, 
            Timestamp = DateTime.Now 
        });

        availableTools = new List<ToolInfo>
        {
            new ToolInfo { Name = "sales_analyst", DisplayName = "Sales", Icon = Icons.Material.Filled.TrendingUp, Description = "Sales performance and revenue analysis" },
            new ToolInfo { Name = "ops_sentinel", DisplayName = "Ops", Icon = Icons.Material.Filled.Storage, Description = "Inventory and operations monitoring" },
            new ToolInfo { Name = "data_gateway", DisplayName = "Data", Icon = Icons.Material.Filled.Analytics, Description = "Structured data and visualizations" },
            new ToolInfo { Name = "market_context", DisplayName = "Market", Icon = Icons.Material.Filled.Public, Description = "Market context and external factors" },
            new ToolInfo { Name = "code_interpreter", DisplayName = "Code", Icon = Icons.Material.Filled.Code, Description = "Code execution and analysis" },
            new ToolInfo { Name = "file_search", DisplayName = "Files", Icon = Icons.Material.Filled.Search, Description = "File search and retrieval" },
            new ToolInfo { Name = "web_search", DisplayName = "Web", Icon = Icons.Material.Filled.Language, Description = "Web search and information gathering" },
            new ToolInfo { Name = "function_calling", DisplayName = "Function", Icon = Icons.Material.Filled.Functions, Description = "Custom function execution" },
            new ToolInfo { Name = "generic_tool", DisplayName = "Tool", Icon = Icons.Material.Filled.Build, Description = "Generic tool or function" }
        };
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage)) return;

        var userMessage = new ChatMessage
        {
            Content = currentMessage,
            IsUser = true,
            Timestamp = DateTime.Now
        };

        messages.Add(userMessage);
        var messageToSend = currentMessage;
        currentMessage = "";
        isLoading = true;

        try
        {
            var request = new AgentRequest(
                AgentName: "chief_analyst",
                Query: messageToSend
            );

            var response = await AgentsClient.ExecuteAsync(request);
            
            var agentMessage = new ChatMessage
            {
                Content = response?.Summary ?? "I'm sorry, I couldn't process your request at the moment. Please try again.",
                IsUser = false,
                Timestamp = DateTime.Now,
                UsedTools = MapToolNames(response?.ToolsUsed)
            };

            messages.Add(agentMessage);
        }
        catch (Exception ex)
        {
            var errorMessage = new ChatMessage
            {
                Content = $"I encountered an error: {ex.Message}. Please check your connection and try again.",
                IsUser = false,
                Timestamp = DateTime.Now
            };
            messages.Add(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetQuery(string query)
    {
        currentMessage = query;
    }

    private async Task StartVoiceInput()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Voice input feature coming soon! 🎤");
    }

    private string GetTimestampStyle(ChatMessage message)
    {
        if (message.IsUser)
        {
            return "color: rgba(255,255,255,0.7); margin-top: 4px; font-size: 0.75rem;";
        }
        else
        {
            return "color: #999; margin-top: 4px; font-size: 0.75rem;";
        }
    }

    private List<string> MapToolNames(List<string>? azureToolNames)
    {
        var mappedTools = new List<string>();
        
        if (azureToolNames == null || !azureToolNames.Any())
            return mappedTools;

        var pairs = new (string From, string To)[]
        {
            ("sales_analyst", "sales_analyst"),
            ("SalesAnalyst", "sales_analyst"),
            ("sales_agent", "sales_analyst"),
            ("SalesAgent", "sales_analyst"),
            ("ops_analyst", "ops_sentinel"),
            ("OpsAnalyst", "ops_sentinel"),
            ("ops_sentinel", "ops_sentinel"),
            ("OpsSentinel", "ops_sentinel"),
            ("operations_agent", "ops_sentinel"),
            ("OperationsAgent", "ops_sentinel"),
            ("data_gateway", "data_gateway"),
            ("DataGateway", "data_gateway"),
            ("data_analyst", "data_gateway"),
            ("DataAnalyst", "data_gateway"),
            ("market_context", "market_context"),
            ("MarketContext", "market_context"),
            ("market_analyst", "market_context"),
            ("MarketAnalyst", "market_context"),
            ("industry_analyst", "market_context"),
            ("IndustryAnalyst", "market_context"),
            ("code_interpreter", "code_interpreter"),
            ("CodeInterpreter", "code_interpreter"),
            ("code_interpreter_tool", "code_interpreter"),
            ("file_search", "file_search"),
            ("FileSearch", "file_search"),
            ("file_search_tool", "file_search"),
            ("web_search", "web_search"),
            ("WebSearch", "web_search"),
            ("web_search_tool", "web_search"),
            ("function_calling", "function_calling"),
            ("FunctionCalling", "function_calling"),
            ("function_call", "function_calling"),
            ("tool", "generic_tool"),
            ("function", "generic_tool"),
            ("assistant", "generic_tool")
        };

        var toolMapping = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var p in pairs)
        {
            toolMapping[p.From] = p.To;
        }
        
        var hasCallIds = azureToolNames.Any(t => t.StartsWith("call_"));
        
        if (hasCallIds)
        {
            if (!mappedTools.Contains("sales_analyst"))
                mappedTools.Add("sales_analyst");
            if (!mappedTools.Contains("ops_sentinel"))
                mappedTools.Add("ops_sentinel");
            if (!mappedTools.Contains("evidence_curator"))
                mappedTools.Add("evidence_curator");
            if (!mappedTools.Contains("data_gateway"))
                mappedTools.Add("data_gateway");
            if (!mappedTools.Contains("market_context"))
                mappedTools.Add("market_context");
        }
        else
        {
            foreach (var toolName in azureToolNames)
            {
                if (toolMapping.TryGetValue(toolName, out var mappedName))
                {
                    if (!mappedTools.Contains(mappedName))
                    {
                        mappedTools.Add(mappedName);
                    }
                }
                else
                {
                    var lowerName = toolName.ToLowerInvariant();
                    if (lowerName.Contains("sales") && !mappedTools.Contains("sales_analyst"))
                        mappedTools.Add("sales_analyst");
                    else if (lowerName.Contains("ops") && !mappedTools.Contains("ops_sentinel"))
                        mappedTools.Add("ops_sentinel");
                    else if ((lowerName.Contains("evidence") || lowerName.Contains("doc")) && !mappedTools.Contains("evidence_curator"))
                        mappedTools.Add("evidence_curator");
                    else if (lowerName.Contains("data") && !mappedTools.Contains("data_gateway"))
                        mappedTools.Add("data_gateway");
                    else if ((lowerName.Contains("market") || lowerName.Contains("industry")) && !mappedTools.Contains("market_context"))
                        mappedTools.Add("market_context");
                    else if (lowerName.Contains("code") && !mappedTools.Contains("code_interpreter"))
                        mappedTools.Add("code_interpreter");
                    else if (lowerName.Contains("file") && !mappedTools.Contains("file_search"))
                        mappedTools.Add("file_search");
                    else if (lowerName.Contains("web") && !mappedTools.Contains("web_search"))
                        mappedTools.Add("web_search");
                    else if (lowerName.Contains("function") && !mappedTools.Contains("function_calling"))
                        mappedTools.Add("function_calling");
                    else
                    {
                        if (!mappedTools.Contains("generic_tool"))
                            mappedTools.Add("generic_tool");
                    }
                }
            }
        }

        return mappedTools;
    }

    public class ChatMessage
    {
        public string Content { get; set; } = "";
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; }
        public List<string> UsedTools { get; set; } = new List<string>();
    }

    public class ToolInfo
    {
        public string Name { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Description { get; set; } = "";
    }
}
